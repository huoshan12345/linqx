{
  "name": "linqx",
  "author": "huoshan12345",
  "description": "Modern fork of linq with more APIs",
  "type": "module",
  "version": "0.3.1",
  "license": "MIT",
  "homepage": "https://github.com/huoshan12345/linqx",
  "repository": {
    "type": "git",
    "url": "https://github.com/huoshan12345/linqx.git"
  },
  "scripts": {
    "prepack": "pinst --disable",
    "postpack": "pinst --enable",
    "preinstall": "npx only-allow pnpm",
    "clean": "shx rm -rf dist/** && shx rm -f *.tgz",
    "build": "run-s clean && run-s build:ts && run-s build:dts",
    "build:ts": "run-s type-check && vite build",
    "build:dts": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "run-s type-check && vitest run",
    "test:watch": "vitest",
    "tutorial": "run-s build && node sample/tutorial.ts",
    "ncu": "npx npm-check-updates -u",
    "p": "run-s build && pnpm pack"
  },
  "preferGlobal": false,
  "keywords": [
    "linq",
    "linqx",
    "linqjs",
    "linqts"
  ],
  "engines": {
    "node": "*"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./extensions": "./dist/extensions.js"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@phiberber/pinst": "^3.0.1",
    "@types/node": "^26.4.1",
    "npm-run-all2": "^9.0.3",
    "shx": "^0.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
