{
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "esnext"
    ],
    "types": [
      "node",
      "vitest/globals"
    ],
  },
  "include": [
    "*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "test"
  ]
}